{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Item de estoque, insumo ou ferramenta no almoxarifado",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "unit": { "type": "string" },
        "currentStock": { "type": "number" },
        "minStock": { "type": "number" },
        "maxStock": { "type": "number" },
        "costPrice": { "type": "number" },
        "salePrice": { "type": "number" },
        "location": { "type": "string" },
        "supplier": { "type": "string" },
        "barcode": { "type": "string" },
        "description": { "type": "string" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["id", "sku", "name", "category", "unit", "currentStock", "minStock", "costPrice"]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Registro de movimentação de entrada, saída ou ajuste de estoque",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "sku": { "type": "string" },
        "type": { "type": "string", "enum": ["ENTRADA", "SAIDA", "AJUSTE"] },
        "subType": { "type": "string" },
        "quantity": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "unitCost": { "type": "number" },
        "totalCost": { "type": "number" },
        "reason": { "type": "string" },
        "documentNumber": { "type": "string" },
        "operator": { "type": "string" },
        "recipient": { "type": "string" },
        "destination": { "type": "string" },
        "constructionSite": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "productId", "type", "quantity", "timestamp"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Fornecedor ou parceiro comercial",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contactName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "cnpj": { "type": "string" },
        "categories": { "type": "string" },
        "address": { "type": "string" },
        "rating": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Colaborador, encarregado ou operador cadastrado",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "department": { "type": "string" },
        "cpf": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "active": { "type": "boolean" },
        "systemAccess": { "type": "boolean" },
        "username": { "type": "string" },
        "systemRole": { "type": "string" },
        "activeCautionsCount": { "type": "number" }
      },
      "required": ["id", "name", "role"]
    },
    "ConstructionSite": {
      "title": "ConstructionSite",
      "description": "Obra, canteiro ou centro de custo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "engineerInCharge": { "type": "string" },
        "manager": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "status": { "type": "string", "enum": ["PLANEJAMENTO", "EM_ANDAMENTO", "CONCLUIDA", "PAUSADA"] },
        "startDate": { "type": "string" },
        "budgetAllocated": { "type": "number" },
        "spentTotal": { "type": "number" },
        "totalItemsAllocated": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "code", "status"]
    },
    "ToolCaution": {
      "title": "ToolCaution",
      "description": "Termo de cautela e controle de empréstimo de ferramenta",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cautionNumber": { "type": "string" },
        "productId": { "type": "string" },
        "toolName": { "type": "string" },
        "sku": { "type": "string" },
        "quantity": { "type": "number" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "employeeRole": { "type": "string" },
        "constructionSiteId": { "type": "string" },
        "constructionSiteName": { "type": "string" },
        "checkoutDate": { "type": "string" },
        "expectedReturnDate": { "type": "string" },
        "returnedDate": { "type": "string" },
        "status": { "type": "string", "enum": ["EM_USO", "DEVOLVIDA", "AVARIADA", "PERDIDA", "ATRASADA"] },
        "conditionOnCheckout": { "type": "string" },
        "conditionOnReturn": { "type": "string" },
        "operatorCheckout": { "type": "string" },
        "operatorReturn": { "type": "string" },
        "notes": { "type": "string" },
        "signatureReceived": { "type": "boolean" }
      },
      "required": ["id", "cautionNumber", "productId", "toolName", "employeeName", "checkoutDate", "status"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Configurações institucionais do sistema",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "tradeName": { "type": "string" },
        "cnpj": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "currency": { "type": "string" },
        "dateFormat": { "type": "string" },
        "enableSoundEffects": { "type": "boolean" },
        "enableBarcodeBeep": { "type": "boolean" },
        "enableStockAlerts": { "type": "boolean" },
        "enableEmailAlerts": { "type": "boolean" },
        "defaultTaxRate": { "type": "number" }
      },
      "required": ["companyName"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Itens e produtos do catálogo de estoque"
    },
    "/movements/{movementId}": {
      "schema": "StockMovement",
      "description": "Histórico de movimentações de estoque"
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Cadastro de fornecedores"
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Cadastro de funcionários e operadores"
    },
    "/constructionSites/{siteId}": {
      "schema": "ConstructionSite",
      "description": "Obras e canteiros de construção"
    },
    "/toolCautions/{cautionId}": {
      "schema": "ToolCaution",
      "description": "Termos de cautela de ferramentas"
    },
    "/settings/{settingId}": {
      "schema": "AppSettings",
      "description": "Configurações globais da empresa"
    }
  }
}
