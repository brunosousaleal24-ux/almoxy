rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Rules for products catalog
    match /products/{productId} {
      allow read, write: if true; // Allows seamless multi-device sync
    }

    // Rules for stock movements
    match /movements/{movementId} {
      allow read, write: if true;
    }

    // Rules for suppliers
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    // Rules for employees
    match /employees/{employeeId} {
      allow read, write: if true;
    }

    // Rules for construction sites / obras
    match /constructionSites/{siteId} {
      allow read, write: if true;
    }

    // Rules for tool cautions / cautelas
    match /toolCautions/{cautionId} {
      allow read, write: if true;
    }

    // Rules for global settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Rules for multi-device broadcast synchronization
    match /system_sync/{syncId} {
      allow read, write: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
